# Docker Compose configuration. Copy to `.env` (same folder as docker-compose.yml)
# and fill in the REQUIRED values. NEVER commit the real .env.

# ---------- REQUIRED ----------
# Postgres password for the bundled database container (startup fails while empty).
POSTGRES_PASSWORD=
# JWT signing secret (startup fails while empty) — generate with:  openssl rand -hex 32
SECRET_KEY=
# Free key from https://console.groq.com (used for SAR drafting)
GROQ_API_KEY=

# ---------- Database (optional) ----------
POSTGRES_USER=aegis
POSTGRES_DB=aegis_db1

# ---------- Networking (optional) ----------
# 127.0.0.1 = only reachable from this machine. Use 0.0.0.0 to expose on your network
# (put a TLS-terminating reverse proxy in front for anything public) — and then also set
# ENVIRONMENT=production: development mode exposes /docs and lets webhook URLs target
# private/internal addresses.
BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=5173
BACKEND_PORT=8000
# Internal nginx<->backend network (defaults shown). Change all three together if 10.177.42.0/24
# clashes with your LAN/VPN or you run a second copy; AEGIS_PROXY_IP must be inside
# AEGIS_SUBNET and outside AEGIS_IP_RANGE.
# AEGIS_SUBNET=10.177.42.0/24
# AEGIS_IP_RANGE=10.177.42.128/25
# AEGIS_PROXY_IP=10.177.42.10
# Public URL of the API — used to build SAR pdf_url links in bank webhooks.
PUBLIC_BASE_URL=http://localhost:8000
# Browser origins allowed to call the API directly (the dashboard goes through nginx
# on the same origin, so this mainly matters for the Mock Bank UI).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# ---------- Startup behaviour ----------
# Run Alembic migrations on every start (idempotent).
RUN_MIGRATIONS=true
# Create the super-admin + demo tenant (TEN-0001) on start (idempotent).
# The demo tenant's API key is printed once in `docker compose logs backend`.
SEED_ON_START=true
# Override the seeded logins (defaults are documented in README — change them!).
# Required when ENVIRONMENT=production and SEED_ON_START=true.
# AEGIS_ADMIN_EMAIL=admin@aegis-aml.com
# AEGIS_ADMIN_PASSWORD=
# AEGIS_TENANT_ADMIN_EMAIL=admin@testfintech.in
# AEGIS_TENANT_ADMIN_PASSWORD=

# ---------- App ----------
# "production" hides /docs and REQUIRES PII_ENCRYPTION_KEY + a non-default SECRET_KEY.
ENVIRONMENT=development
# Fernet key for PII encryption at rest. Required in production — generate with:
#   docker compose run --rm --no-deps --entrypoint python backend -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it safe: losing it makes stored PII unreadable.
PII_ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Comped tenants: comma-separated PUBLIC tenant ids (e.g. TEN-0002) billed Rs.0 and pinned to
# the free drafting plan. Empty = nobody. Public ids are handed out in approval order, so only
# list an id after the tenant you mean has been approved and received it.
COMPED_TENANT_IDS=

# ---------- LLM providers ----------
LLM_PROVIDER=groq
GROQ_MODEL=llama-3.3-70b-versatile
LLM_FALLBACK_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
