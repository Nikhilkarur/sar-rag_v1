DATABASE_URL=postgresql://postgres:karur123@localhost:5432/aegis_db1
SECRET_KEY=your-super-secret-jwt-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173

# --- LLM drafting: FREE tier (live) ---
# Every tenant runs on this today (Groq primary -> Gemini failover). See model_router.py.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
LLM_PROVIDER=groq
LLM_FALLBACK_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- LLM drafting: PAID / PRO tier (PLACEHOLDER — not live) ---
# Leave ANTHROPIC_API_KEY empty to keep paid inference OFF. When set, tenants on a PRO plan
# (see model_router.PLAN_TIER / TENANT_PLAN_OVERRIDES) draft on Anthropic instead. TEN-0005 is
# pinned to the free tier and is never routed here.
ANTHROPIC_API_KEY=
PRO_MODEL=claude-opus-4-8
PRO_MODEL_STANDARD=claude-sonnet-4-6
